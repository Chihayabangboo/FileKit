<Application x:Class="FileKit.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                全局字体：系统级无衬线字体，中文 Microsoft YaHei UI，西文回退 Segoe UI。
                不随程序打包第三方字体，完全使用系统自带字体，避免重影/发虚/彩边。
            -->
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>

            <!-- 全局默认字体：窗口/控件/文本块统一使用系统雅黑；文本渲染统一 Grayscale + Display -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
