<Window x:Class="FileKit.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FileKit"
        Icon="app.ico"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceFallbackBrush" Color="#E9EDF2" />
        <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="TabBarBorderBrush" Color="#1A000000" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#24000000" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F1F" />

        <Style x:Key="RoundedButtonBaseStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource RoundedButtonBaseStyle}">
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="BorderBrush" Value="#0067C0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource RoundedButtonBaseStyle}">
            <Setter Property="Background" Value="#0D000000" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!--
            自定义 TabControl 模板：去掉 WPF 默认模板根 Grid 的 ClipToBounds=True 和
            HeaderPanel 的 2px Margin，避免最右侧标签的 1px 边框/圆角被裁掉。
        -->
        <Style x:Key="PluginTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid x:Name="TabLayoutRoot"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Margin="0"
                                      Background="Transparent"
                                      ClipToBounds="False"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="2" />
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ClipToBounds="False"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PluginTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <!-- TabItem 自身不设 Margin：TabPanel 会把 Margin 计入布局槽并产生 LayoutClip，裁掉右侧边框。 -->
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- 内容区必须 Stretch；标签头文字在模板内单独居中，不能被这个 Setter 影响。 -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Margin="0,0,10,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <!-- 选中标签置于相邻标签之上，右侧 1px 边框和圆角不会被后绘制的元素盖住。 -->
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource SurfaceFallbackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="56"
                Background="{StaticResource TabBarBackgroundBrush}"
                BorderBrush="{StaticResource TabBarBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <CheckBox x:Name="DeveloperModeCheckBox"
                          Content="开发者模式"
                          Margin="0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          ToolTip="勾选后启用开发者模式（可加载/安装额外特效）"
                          Checked="DeveloperModeCheckBox_Checked"
                          Unchecked="DeveloperModeCheckBox_Unchecked" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ManageEffectsButton"
                            Content="特效管理"
                            Visibility="Collapsed"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ManageEffectsButton_Click" />
                    <Button Content="插件管理"
                            Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ManagePluginsButton_Click" />
                    <Button Content="安装插件"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="InstallPluginButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TabControl x:Name="PluginTabControl"
                        Margin="20,12,20,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ClipToBounds="False"
                        Visibility="Collapsed"
                        Style="{StaticResource PluginTabControlStyle}"
                        ItemContainerStyle="{StaticResource PluginTabItemStyle}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

            <Border x:Name="EmptyStatePanel"
                    MaxWidth="640"
                    Margin="32,0"
                    Padding="44,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="当前无已安装插件，请点击右上角【安装插件】进行添加。"
                           FontSize="16"
                           LineHeight="26"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- M3：特效 Overlay 层（最上层、不拦截鼠标，保证不遮挡主程序交互）。 -->
        <Grid x:Name="EffectOverlayLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="1000"
              Background="Transparent"
              IsHitTestVisible="False" />
    </Grid>
</Window>
